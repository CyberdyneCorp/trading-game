{
	"name": "tradelab-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.service-worker.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"engine:build": "./scripts/build-engine.sh",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"budget:size": "node scripts/check-budgets.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/vt323": "^5.3.0",
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"fake-indexeddb": "^6.0.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
