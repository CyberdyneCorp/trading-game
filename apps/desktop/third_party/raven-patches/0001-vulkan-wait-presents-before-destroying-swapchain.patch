+/* Frame fences cover the rendering only: MoltenVK presents from a command buffer of its own, whose
+ * scheduled handler still touches the swapchain image. The whole queue goes idle before a swapchain is
+ * destroyed, or that handler runs on freed memory (a SIGSEGV in the Metal completion thread on macOS). */
+static void rvn_vk_wait_presents(void) {
+	if (!g_vk.device || g_vk.device_lost || !rvn_vk.DeviceWaitIdle) return;
+	rvn_vk_queue_lock();
+	rvn_vk.DeviceWaitIdle(g_vk.device);
+	rvn_vk_queue_unlock();
+}
