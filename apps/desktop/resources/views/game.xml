                    <Spacer Slot.Fill="1"/>
                    <Button Name="game-combo-close-no"/>
                    <Button Name="game-combo-close-yes" Style="Primary"/>
                </HBox>
            </VBox>
        </Switcher>
    </Border>
</Border>
