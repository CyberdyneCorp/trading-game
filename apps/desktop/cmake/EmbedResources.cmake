# Embeds files into a generated C++ source as byte arrays (no raw-string delimiter pitfalls).
# Runs at configure time; the files are CMAKE_CONFIGURE_DEPENDS, so editing one re-runs configure.

function(tradelab_embed_resources out_cpp base_dir)
  set(arrays "")
  set(entries "")
  set(index 0)
  foreach(rel IN LISTS ARGN)
    set(file "${base_dir}/${rel}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" hex HEX)
    file(SIZE "${file}" size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND arrays "alignas(8) constexpr unsigned char kData${index}[] = {${bytes} 0x00};\n")
    string(APPEND entries "  {\"${rel}\", std::string_view(reinterpret_cast<const char*>(kData${index}), ${size})},\n")
    math(EXPR index "${index} + 1")
  endforeach()
  file(CONFIGURE OUTPUT "${out_cpp}" CONTENT [=[
// Generated by cmake/EmbedResources.cmake. Do not edit.
#include "model/resources.hpp"

#include <array>

namespace tradelab::desktop {
namespace {
@arrays@
const std::array<Resource, @index@> kResources = {{
@entries@}};
}  // namespace

std::span<const Resource> resources() { return kResources; }

std::string_view resource_text(std::string_view path) {
  for (const auto& r : kResources) {
    if (r.path == path) return r.data;
  }
  return {};
}

}  // namespace tradelab::desktop
]=] @ONLY)
endfunction()
