# TradeLab engine IDL: the enumerations shared by state, commands, events and the debrief, and the
# JSON shapes the C ABI (engine/include/tradelab/c_api.h) returns. engine/idl/gen.py writes:
#   engine/include/tradelab/idl_types.hpp   C++ enums (numeric values) and their JSON names
#   engine/tests/idl_schema.hpp             the shapes, checked against real C ABI output
#   apps/web/src/lib/engine/types.ts        TypeScript types for the web client
# Never edit those files by hand: edit this one and run `python3 engine/idl/gen.py`.
#
# Syntax
#   # comment                     ignored
#   /// text                      documentation of the next declaration, member or field
#   enum Name : u8|i8 [ts=TsName, codes=CONST] { Member = value ["json"] }
#                                 C++ enum class + JSON name (default: Member in snake_case);
#                                 numeric values are part of the recorded-run format: never
#                                 renumber, only append. [cpp_only] keeps it out of TypeScript.
#   union Name = "lit" | 1 | Ref  TypeScript-only union of literals and other types
#   tuple Name = [T, T, T?]       fixed-length JSON array (T? = optional trailing element)
#   struct Name [: Base] { field[?]: Type }   JSON object; `?` = the key may be absent
# Types: string, int, bool, Decimal (fixed-point value as a decimal string: display it, never do
# state math on it), a declared name, T[] (array), T | null, ( ... ) for grouping.

# --- Enumerations -----------------------------------------------------------------------------

enum OrderSide : u8 [ts=OrderSideName, codes=SIDE_CODE] {
  Buy = 0
  Sell = 1
}

enum OrderType : u8 [ts=OrderTypeName, codes=ORDER_TYPE_CODE] {
  Market = 0
  Limit = 1
  StopMarket = 2
  /// Limit order on the exit side, always reduce-only.
  TakeProfit = 3
  /// Stop-market whose trigger ratchets with closes (effective next bar).
  TrailingStop = 4
}

enum OrderStatus : u8 [ts=OrderStatusName] {
  Accepted = 0
  PartiallyFilled = 1
  Filled = 2
  Cancelled = 3
  Rejected = 4
  Expired = 5
  Triggered = 6
}

/// Why a command was refused or an order changed; also the informational warning of an accepted order.
enum Reason : u8 [ts=ReasonCode] {
  None = 0
  InsufficientMargin = 1
  LeverageAboveCap = 2
  InvalidTick = 3
  InvalidQuantity = 4
  UnsupportedOrderType = 5
  ReduceOnlyWouldIncrease = 6
  RunBankrupt = 7
  RunFinished = 8
  InsufficientCapacity = 9
  Liquidation = 10
  PositionClosed = 11
  UserCancelled = 12
  UnknownOrder = 13
  InvalidSequence = 14
  WrongDecisionStep = 15
  NumericOverflow = 16
  InvalidLeverage = 17
  PositionOpen = 18
  /// Informational flag on accepted orders.
  StopBeyondLiquidation = 19
  ShortNotAllowed = 20
  Expired = 21
  InvalidBracket = 22
  OcoSiblingFilled = 23
  SeriesNotListed = 24
  ShortOptionsNotAllowed = 25
  NoBid = 26
  MarginCall = 27
  MarginBelowInitial = 28
  NoQuestionDue = 29
  InvalidPlan = 30
  /// RequestAdvice with no allowance left (changes no state).
  NoAdviceLeft = 31
  /// OrderUpdate reason: a working exit moved to a new trigger (MoveOrder).
  OrderMoved = 32
  /// The position's notional tier caps leverage below the run's (policy v16).
  LeverageAboveTier = 33
  /// The option order would execute inside its series' settlement window (policy v17).
  SeriesSettling = 34
  /// AnswerLesson: the mission has no such lesson question (scoring v11).
  UnknownQuestion = 35
  /// AnswerLesson: each question is answered once.
  AlreadyAnswered = 36
  /// AnswerLesson: choice out of range or a negative numeric answer.
  InvalidAnswer = 37
  /// OrderUpdate reason (policy v18): the order's time in force ended (bars elapsed, or an ioc/fok
  /// remainder after its one open phase).
  TimeInForce = 38
  /// A time in force the order cannot take: ioc/fok on a non-limit order, bars 0 or beyond the run's
  /// last bar, or a bars value without the bars kind (policy v18).
  InvalidTimeInForce = 39
  /// LinkOco: the same order twice, an unknown or inactive order, a bracket child or an order already linked (policy v18).
  InvalidOco = 40
}

/// How long an order works (execution policy v18). An absent value is gtc.
enum TimeInForce : u8 [ts=TimeInForceName] {
  /// Until filled, cancelled, the run ends or (options) its series settles.
  Gtc = 0 "gtc"
  /// Eligible on bars placedStep+1 .. placedStep+tifBars; the remainder expires at the close of the last one.
  Bars = 1 "bars"
  /// Limit only: eligible only in the next bar's open phase; the remainder is cancelled after it.
  Ioc = 2 "ioc"
  /// Limit only: the whole quantity in the next bar's open phase, or nothing.
  Fok = 3 "fok"
}

enum EventType : u8 [ts=EventTypeName] {
  /// Status change of an order (see OrderStatus).
  OrderUpdate = 0 "order"
  Fill = 1
  Funding = 2
  Liquidation = 3
  Bankrupt = 4
  RunFinished = 5
  LeverageChanged = 6
  OptionSettlement = 7
  MarginCall = 8
  MarginAdjusted = 9
}

enum RunStatus : u8 {
  Active = 0
  Finished = 1
  Bankrupt = 2
}

/// Player commands (the recorded-run format); each is one C ABI call (see the *Command structs).
enum CommandType : u8 [cpp_only] {
  PlaceOrder = 0
  CancelOrder = 1
  SetLeverage = 2
  ClosePosition = 3
  /// order_type Market or Limit; price = premium limit; series required.
  PlaceOptionOrder = 4
  /// Add (> 0) or remove (< 0) isolated margin on the open perpetual position.
  AdjustMargin = 5
  /// Structured plan for the next exposure-increasing order.
  RecordPlan = 6
  /// Calibration answer for the question due at this step.
  AnswerQuestion = 7
  /// Advisor read of the visible market; uses one unit of the allowance.
  RequestAdvice = 8
  /// order_id + price: moves a working reduce-only stop/take-profit, keeping its OCO link (v13).
  MoveOrder = 9
  /// question + choice or value: a structured lesson answer (understanding dimension, scoring v11).
  AnswerLesson = 10
  /// order_id + order_id_b: links two working orders as one-cancels-the-other (policy v18).
  LinkOco = 11
}

/// Advisor (spec advisor): what the advice says. Short/Wait/Long = -1/0/+1.
enum AdviceStance : i8 {
  Short = -1
  Wait = 0
  Long = 1
}

enum AdviceReasonCode : u8 {
  RegimeTrendUp = 0
  RegimeTrendDown = 1
  RegimeRange = 2
  RsiExtreme = 3
  BandFade = 4
  MacdMomentum = 5
  Pattern = 6
  NewsPriced = 7
  NewsEarly = 8
  FundingCrowded = 9
  LowVolSqueeze = 10
  /// An announced release within the next bars (G3): toward wait.
  EventAhead = 11
}

/// How indicators treat continuity bars (policy v17): Skip leaves them out of every input (no value at
/// a continuity bar; VWAP sessions still count real bars); CarryForward feeds them as flat bars at the
/// previous close with zero volume.
enum GapPolicy : u8 {
  Skip = 0 "skip"
  CarryForward = 1 "carryForward"
}

enum OptionKind : u8 {
  Call = 0
  Put = 1
}

enum NewsKind : u8 {
  RateDecision = 0
  RegulationRumor = 1
  ExchangeIncident = 2
  NetworkOutage = 3
  LiquidityInflow = 4
  InstitutionalAdoption = 5
  RumorDenied = 6
  /// Phase-2 flows (design D8): appended, existing values keep their numbers.
  LiquidityOutflow = 7
  /// Phase-2 scheduled releases: a fictional economic print.
  MacroData = 8
  NetworkUpgrade = 9
}

/// What a generated segment is, for the debrief reveal and for tests (generator v3). It never feeds generation.
enum RegimeLabel : u8 {
  Unlabeled = 0
  Range = 1
  Trend = 2
  HighVol = 3
  LowLiquidity = 4
  Crowded = 5
  Calm = 6
  Shock = 7
}

enum FindingCode : u8 {
  Waited = 0
  Liquidated = 1
  StopBeyondLiq = 2
  NoStop = 3
  GapSlippage = 4
  FundingCost = 5
  Ambiguous = 6
  Capacity = 7
  GoodProcessLoss = 8
  LuckyWin = 9
  NoPlan = 10
  Oversized = 11
  Bankrupt = 12
  /// Written options bought back by force (step, buy-back premium, loss).
  MarginCalled = 13
  /// Time decay (theta) explains at least half of an option loss (amount = theta P&L lost).
  ThetaDecay = 14
  /// Falling implied volatility (vega) on bought options explains at least half of an option loss.
  IvCrush = 15
  /// A profit where every trade had a plan and limited risk (the counterpart of GoodProcessLoss).
  GoodProcessWin = 16
  /// Rising implied volatility (vega) on written options explains at least half of an option loss.
  IvRise = 17
  /// Options were written and no margin call followed: risk limited by neither a stop nor a premium.
  WroteOptions = 18
  /// Scoring v11: liquidation closer to the entry than twice the stop distance (step, leverage, stop, liquidation price).
  LeverageVsStop = 19
  /// Scoring v11: the closest liquidation distance at a close fell below the mission's warning distance (count = bp).
  LiqBuffer = 20
  /// Scoring v11: max drawdown above the mission's drawdown budget (count = budget bp, amount = drawdown).
  DrawdownBudget = 21
  /// Scoring v14 (report-only): an exposure-increasing entry within 3 bars of a perpetual trade closed at
  /// a loss, at 1.5x its size or more or without a plan (step = entry, count = size ratio bp, amount = loss).
  RevengeTrade = 22
  /// Scoring v14 (report-only): an entry after 4+ closes its way, more than 2 ATR beyond SMA(20), with no
  /// stop or one more than 2 ATR away (step = entry, count = closes, price = stop).
  FomoEntry = 23
  /// Scoring v14 (report-only): an add at a worse price than the average entry while losing, raising the
  /// risk above the first entry's plan or without a stop (step = add, price = fill, requested = average before).
  AveragingDown = 24
  /// Scoring v14 (report-only): a mission risk limit exceeded at a close (step = first, count = closes).
  RiskLimitExceeded = 25
}

enum FindingTone : u8 {
  Good = 0
  Warn = 1
  Bad = 2
  Info = 3
}

enum LessonCode : u8 {
  Futures2 = 0 "futures2"
  Risk = 1
  Futures3 = 2 "futures3"
  Orders = 3
  Structure = 4
  Evaluation = 5
  Options = 6
}

/// What a mission asks of the player (task 4.1): the client renders each code as text in the player's
/// language; the objective's `valueBp` is its number where it has one (a share in basis points).
enum ObjectiveCode : u8 {
  /// A hypothesis and an invalidation level before every entry.
  PlanEveryEntry = 0
  /// Planned risk of at most valueBp of equity per idea.
  RiskPerIdea = 1
  /// Do not get liquidated; waiting is a valid decision.
  NoLiquidationWaitOk = 2
  /// Keep the distance to liquidation above valueBp.
  LiqDistance = 3
  /// Choose leverage from the stop, not from the cap.
  LeverageFromStop = 4
  LiquidationLosesMargin = 5
  BankruptcyGameOver = 6
  /// Before buying, write the scenario in which the option loses.
  OptionLoseScenario = 7
  PremiumVsBreakeven = 8
  WatchIvEvent = 9
  /// Before writing, compute the margin and the worst case.
  WriterWorstCase = 10
  MaintenanceBuffer = 11
  ThetaForSeller = 12
  LimitOrdersAtZones = 13
  UnfilledLimitOk = 14
  /// Risk of at most valueBp per idea, quantity set by the stop.
  RiskFromStop = 15
  TrailNotTighterThanAtr = 16
  /// Finish without a drawdown above valueBp (the mission's drawdown budget).
  DrawdownBudget = 17
  RegimeInPlan = 18
  OneToolPerRegime = 19
  StraddleBreakevens = 20
  StraddleLoseScenario = 21
  /// Do not pay more than valueBp of equity in premium.
  PremiumBudget = 22
  StructureMaxLoss = 23
  WrittenMarginBuffer = 24
  FundingVsTheta = 25
  DecideBeforeRelease = 26
  NoChasingHeadline = 27
  /// Planned risk of at most valueBp, counting the gap.
  RiskWithGap = 28
  FinishMission = 29
  PlanAndStopEveryEntry = 30
  NoLiquidationNoMarginCall = 31
  ReadCampaignReport = 32
  /// Strategies (m13-m17, add-academy-and-strategies D8). Before entering, write both structures'
  /// breakevens and maximum loss (spread against naked call).
  SpreadBreakevens = 33
  /// Never leave a short option uncovered: close it before or with its long.
  CoverShortLeg = 34
  /// Before selling the call, write the capped maximum profit.
  CappedMaxProfit = 35
  /// Compare the premium collected with the funding paid.
  PremiumVsFunding = 36
  /// Before buying the put, write the floor (maximum loss).
  FloorBeforeBuying = 37
  /// Choose and record the hedge's tenor.
  RecordTenor = 38
  /// Size a defined-risk structure by its maximum loss: at most valueBp of equity.
  SizeByMaxLoss = 39
  /// Before entering, write the exit rule for a breakout.
  BreakoutExitRule = 40
  /// Before an expiry's last 5 bars, decide to close, roll or hold, and record why.
  DecideBeforeExpiry = 41
  /// Do not roll without a new thesis.
  NoRollWithoutThesis = 42
  /// Missions m18-m25 (add-practice-and-advanced-strategies D12). Keep |delta| within valueBp of
  /// equity (the mission's risk limit).
  DeltaWithinLimit = 43
  /// Before entering, record the rehedge rule (every N bars or a delta band).
  RehedgeRuleFirst = 44
  /// Before entering, write the carry break-even: the funding needed to pay the costs.
  CarryBreakevenFirst = 45
  /// Keep |vega| within valueBp of equity per volatility point (the mission's risk limit).
  VegaWithinLimit = 46
  /// Before the release bar, decide whether to hold through it, and record why.
  HoldThroughDecision = 47
  /// Before entering, write the net debit: the maximum loss at the near expiry.
  NetDebitFirst = 48
  /// Keep the gamma of a 1% move within valueBp of equity (the mission's risk limit).
  GammaWithinLimit = 49
  /// Total planned risk of at most valueBp across all entries of one idea.
  TotalRiskAllEntries = 50
  /// Use at least one partial exit or a trailing stop.
  PartialExitOrTrail = 51
  /// Never move a stop away from the entry.
  NeverStopAway = 52
  /// No new entry within 3 bars of a stop-out without a new plan.
  CooldownAfterStop = 53
  /// Every entry with a plan recorded before it and a stop within 2 x ATR.
  PlanBeforeEntryAtrStop = 54
  /// No add to a losing position beyond the planned total risk.
  NoAddBeyondPlan = 55
}

/// What the player did at a decision point (task 4.2, spec gameplay-loop "Waiting is a decision").
enum DecisionKind : u8 {
  /// No order placed, cancelled or moved, no leverage or margin change, and no exposure.
  Wait = 0
  /// No such command while a position (perpetual or option) stayed open.
  Hold = 1
  /// At least one accepted command that placed, cancelled or moved an order, or changed leverage or margin.
  Act = 2
}

/// How a round trip ended (scoring v10: from the order type; a stop in profit is a stop).
enum ExitReason : u8 {
  Stop = 0
  Target = 1
  Manual = 2
  Liquidation = 3
  Open = 4
  Expiry = 5
  MarginCall = 6
  Trailing = 7
}

/// A reference structure of the strategy comparison (scoring v13, add-academy-and-strategies design D8;
/// m18-m22 since scoring v14).
enum ComparisonStrategy : u8 {
  /// m13: a call at the money.
  NakedCall = 0
  /// m13: that call bought, the next strike up written.
  BullCallSpread = 1
  /// m14, m15: the perpetual long alone, held to the end.
  LongOnly = 2
  /// m14: the long plus a call about 5% out of the money written, written again at each settlement.
  CoveredCall = 3
  /// m15: the long with a protective stop 2 x ATR(14) below the entry close.
  AtrStop = 4
  /// m15: the long plus a put at the money of the second expiry.
  AtmPut = 5
  /// m15: the long plus a put about 5% out of the money of the second expiry.
  OtmPut = 6
  /// m16: a put and a call 2 strikes out written, held to settlement.
  ShortStrangle = 7
  /// m16: the strangle plus the strikes 4 out bought (wings), held to settlement.
  IronCondor = 8
  /// m17: a put at the money written and held to settlement.
  HoldToSettlement = 9
  /// m17: the same put bought back 5 bars before its expiry.
  CloseBeforeExpiry = 10
  /// m17: the same put rolled 5 bars before each expiry into the next expiry's put at the money.
  RollBeforeExpiry = 11
  /// Scoring v14 (add-practice-and-advanced-strategies D13). m18: a straddle at the money of the first
  /// expiry, held to its settlement.
  UnhedgedStraddle = 12
  /// m18: the same straddle, its delta brought to zero with the perpetual at every 4th close.
  HedgedEvery4 = 13 "hedged_every_4"
  /// m18: the same straddle, hedged whenever |delta| exceeds 40% of the contracts.
  HedgedBand = 14
  /// m19: the perpetual short alone at 5x, held to the end.
  UnhedgedShort = 15
  /// m19: the short plus a synthetic long (call bought, put written at the money of the last expiry), 5x.
  HedgedCarry5x = 16 "hedged_carry_5x"
  /// m19: the same hedged carry with the perpetual at 2x.
  HedgedCarry2x = 17 "hedged_carry_2x"
  /// m20: a straddle of the last expiry bought at the announcement and sold the bar before the release.
  EarlySellBefore = 18
  /// m20: the same straddle held through the release (sold 3 bars after it).
  EarlyHoldThrough = 19
  /// m20: a straddle of the first expiry bought the bar before the release, sold 3 bars after it.
  LateHoldThrough = 20
  /// m20: that straddle written the bar before the release, bought back 3 bars after it.
  ShortStraddleThrough = 21
  /// m21: a call calendar at the money (near written, next bought), closed at the near expiry.
  CalendarAtm = 22
  /// m21: a diagonal: the next expiry's call one strike up bought instead.
  DiagonalUp = 23
  /// m21: a straddle of the near expiry written and held to its settlement.
  ShortStraddleNear = 24
  /// m22: in 3 bars after the headline with its move, 1% at risk to a 2 x ATR stop, all out at 2R.
  AllOut2R = 25 "all_out_2r"
  /// m22: half out at +1R, the stop to breakeven, the rest trailed at 2 x ATR.
  ManagedExit = 26
  /// m22: the initial stop only, held to the end.
  HoldInitialStop = 27
}

/// Advice in the debrief: a long or short read is right when the close 5 bars after the next open moved its way.
enum AdviceOutcome : u8 {
  Right = 0
  Wrong = 1
  Wait = 2
  Open = 3
}

# --- Missions and version ---------------------------------------------------------------------

/// tl_version.
struct EngineVersion {
  engine: string
  executionPolicy: int
}

/// One entry of tl_missions.
struct MissionInfo {
  id: string
  totalBars: int
  warmupBars: int
  leverageCap: int
  allowShort: bool
}

# --- State (tl_state, tl_advance) -------------------------------------------------------------

/// Maintenance-margin tier by notional at entry (policy v16).
struct MarginTier {
  notionalFloor: Decimal
  maintenanceMargin: Decimal
  maxLeverage: int
}

struct Contract {
  tickSize: Decimal
  lotSize: Decimal
  minQty: Decimal
  multiplier: Decimal
  maxLeverage: int
  leverageCap: int
  makerFee: Decimal
  takerFee: Decimal
  maintenanceMargin: Decimal
  fundingInterval: int
  allowShort: bool
  halfSpread: Decimal
  slippage: Decimal
  capacityFraction: Decimal
  /// Maintenance-margin tiers by notional at entry, the base tier first (floor 0); policy v16.
  marginTiers?: MarginTier[]
  /// Policy v17: true when the scenario has no mark series, so margin and liquidation use the last price.
  markFromLastPrice?: bool
  /// Policy v17: how indicators treat continuity bars (no trading).
  gapPolicy?: GapPolicy
  /// True when the market carries liquidity shocks (wider spread and slippage, less capacity on some bars).
  liquidityShocks?: bool
}

/// [open, high, low, close, volume, synthetic, continuity]; continuity (policy v17): the market did not trade.
tuple BarTuple = [Decimal, Decimal, Decimal, Decimal, Decimal, bool, bool?]

struct Account {
  wallet: Decimal
  equity: Decimal
  unrealized: Decimal
  positionMargin: Decimal
  orderMargin: Decimal
  available: Decimal
  notional: Decimal
  mark: Decimal
  liquidationPrice: Decimal | null
  nextFundingRate: Decimal
  nextFundingStep: int
}

struct Position {
  /// Signed: > 0 long, < 0 short.
  qty: Decimal
  entry: Decimal
  margin: Decimal
}

struct OrderView {
  id: int
  type: OrderType
  side: OrderSide
  qty: Decimal
  filled: Decimal
  price: Decimal
  reduceOnly: bool
  status: OrderStatus
  placedStep: int
  parentId: int
  ocoGroup: int
  trailDistance: Decimal
  /// Trailing distance as a rate of the best close (policy v16); "0" for a fixed distance.
  trailRate?: Decimal
  bracketStop: Decimal
  bracketTp: Decimal
  series: int
  /// Policy v18: how long the order works (absent from builds that predate it: gtc).
  tif?: TimeInForce
  /// Policy v18: the N of a bars time in force; 0 otherwise.
  tifBars?: int
  /// Policy v18: the last bar the order can execute on (bars: placedStep + N; ioc/fok: placedStep + 1); 0 = none.
  expireStep?: int
  /// Policy v18: a player-built OCO link (the lower order id of the pair); 0 = not linked. Separate from ocoGroup.
  linkGroup?: int
}

struct EngineEvent {
  seq: int
  step: int
  type: EventType
  orderId: int
  /// Type of the order the event refers to; null for events without an order.
  orderType: OrderType | null
  status: OrderStatus
  reason: Reason
  side: OrderSide
  qty: Decimal
  price: Decimal
  requested: Decimal
  amount: Decimal
  pnl: Decimal
  ambiguous: bool
  gap: bool
  capacityLimited: bool
  series: int
  approximate: bool
}

struct Totals {
  realizedPnl: Decimal
  feesPaid: Decimal
  fundingNet: Decimal
  insuranceAbsorbed: Decimal
  turnover: Decimal
  peakEquity: Decimal
  maxDrawdown: Decimal
  peakLeverageBp: int
  minLiqDistanceBp: int
  liquidations: int
  fills: int
  ambiguousFills: int
  optionCash: Decimal
  optionRealized: Decimal
}

struct OptionQuoteView {
  id: int
  kind: OptionKind
  strike: Decimal
  listStep: int
  expiryStep: int
  listed: bool
  bid: Decimal
  ask: Decimal
  mid: Decimal
  iv: Decimal
  delta: Decimal
  gamma: Decimal
  theta: Decimal
  vega: Decimal
  ivFromRealized: bool
  /// Policy v17: an order placed now would execute inside the settlement window (refused, series_settling).
  settling?: bool
}

struct OptionPositionView {
  series: int
  /// Signed.
  qty: Decimal
  avgPremium: Decimal
}

struct OptionsView {
  enabled: bool
  allowShort: bool
  multiplier: Decimal
  premiumTick: Decimal
  lotSize: Decimal
  /// Option fee: this fraction of the underlying notional, capped at 12.5% of the premium.
  feeRate?: Decimal
  /// Settlement window in market time, minutes (policy v17).
  settlementMinutes?: int
  longValue: Decimal
  shortValue: Decimal
  initialMargin: Decimal
  maintenanceMargin: Decimal
  chain: OptionQuoteView[]
  positions: OptionPositionView[]
}

union PatternBias = -1 | 0 | 1

struct PatternHitView {
  /// Bar that completes the pattern.
  step: int
  /// Matches the cheat sheet ids.
  id: string
  bars: int
  bias: PatternBias
}

struct Indicators {
  version: int
  sma20: (Decimal | null)[]
  ema50: (Decimal | null)[]
  rsi14: (Decimal | null)[]
  atr14: (Decimal | null)[]
  vwap: (Decimal | null)[]
  bbUpper: (Decimal | null)[]
  bbLower: (Decimal | null)[]
  macd: (Decimal | null)[]
  macdSignal: (Decimal | null)[]
  macdHist: (Decimal | null)[]
  plusDi14: (Decimal | null)[]
  minusDi14: (Decimal | null)[]
  adx14: (Decimal | null)[]
  patternVersion: int
  patterns: PatternHitView[]
}

/// An announced release not out yet: never its tone, actual or credibility.
struct UpcomingView {
  step: int
  kind: NewsKind
  /// The consensus, -2..2.
  expectation: int
}

struct NewsView {
  step: int
  kind: NewsKind
  tone: int
  credibility: int
  expectation: int
  actual: int
  /// Delivered ahead of its public release by a fast wire (until `step`).
  early: bool
}

/// Calibration question state at the current step.
struct CalibrationState {
  due: bool
  horizon: int
  every: int
  threshold: Decimal
  answered: int
}

/// One reason: `vote` > 0 long, < 0 short, 0 toward wait or a warning; `ref` = bar (pattern, news) or crowded side.
struct AdviceReasonView {
  code: AdviceReasonCode
  vote: int
  ref: int
}

struct AdviceView {
  step: int
  stance: AdviceStance
  confidenceBp: int
  /// "0" when waiting.
  stop: Decimal
  /// "0" when waiting or below the minimum order.
  size: Decimal
  reasons: AdviceReasonView[]
}

struct AdvisorState {
  version: int
  allowance: int
  left: int
  newsLead: int
  calendar: bool
  advice: AdviceView[]
}

/// A mission objective (task 4.1).
struct MissionObjective {
  code: ObjectiveCode
  valueBp: int
}

/// Instrument permissions: long always, short = allowShort, options buying when a chain is listed,
/// options writing when the option spec allows it.
struct MissionPermissions {
  long: bool
  short: bool
  optionsBuy: bool
  optionsWrite: bool
}

/// The mission's rules as the run plays them (task 4.1): what the briefing lists and the ticket enforces.
struct MissionRulesView {
  initialBalance: Decimal
  leverageCap: int
  warmupBars: int
  permissions: MissionPermissions
  objectives: MissionObjective[]
  /// Warn at decision points when liquidation is closer than this to the last close (basis points).
  liqWarningBp: int
  /// Max drawdown the mission allows, basis points of the run's initial capital (risk score).
  drawdownBudgetBp: int
  /// The ticket asks for explicit confirmation of a stop beyond the liquidation price.
  confirmStopBeyondLiq: bool
  /// Defined-risk spread margin (add-academy-and-strategies D5): a short paired with longs of the same
  /// kind and expiry is margined at most at its worst loss at expiry; false = every short per leg.
  /// Absent from builds that predate it.
  spreadMargin?: bool
  /// Calendar margin (add-practice-and-advanced-strategies D5): a long expiring at or after the short's
  /// expiry may cover it too. Absent from builds that predate it.
  calendarMargin?: bool
  /// Portfolio risk limits in basis points of equity (D9); absent when the mission declares none.
  riskLimits?: RiskLimitsView
}

/// Per-mission risk limits (add-practice-and-advanced-strategies D9), only those declared: |delta
/// notional|, the gamma P&L of a 1% move, |vega per point| and theta burn per bar, as bp of equity.
struct RiskLimitsView {
  deltaBp?: int
  gammaBp?: int
  vegaBp?: int
  thetaBp?: int
}

/// The cost model with the liquidity shock in force applied (same fields as the contract's).
struct LiquidityView {
  halfSpread: Decimal
  slippage: Decimal
  capacityFraction: Decimal
}

struct GameState {
  mission: string
  alias: string
  status: RunStatus
  /// 'synthetic' for built-in missions; the pack mode ('historical', ...) for pack runs.
  marketMode: string
  /// Imported packs are known scenarios (spec scenario-packs "Reveal metadata").
  knownScenario: bool
  /// Bar interval in seconds: 3600 for the missions, the declared one for a pack (e.g. 900).
  stepSeconds: int
  step: int
  lastDecisionStep: int
  warmupBars: int
  totalBars: int
  initialBalance: Decimal
  leverage: int
  contract: Contract
  missionRules: MissionRulesView
  bars: BarTuple[]
  account: Account
  position: Position
  orders: OrderView[]
  options: OptionsView
  indicators: Indicators
  news: NewsView[]
  /// Economic calendar perk: bars of upcoming scheduled releases (rate decisions), nothing else.
  calendar: int[]
  /// Costs an order placed now executes with while a visible liquidity shock covers the next bar (null otherwise).
  liquidity?: LiquidityView | null
  /// Announced releases (G3), from their announcement to their release: kind, bar and consensus only.
  upcoming: UpcomingView[]
  calibration: CalibrationState
  advisor: AdvisorState
  events: EngineEvent[]
  totals: Totals
  digest: string
  eventsDigest: string
}

# --- Commands ---------------------------------------------------------------------------------
# Each command is one C ABI call at the current decision step; the engine assigns the sequence
# number and decision step. Decimal inputs are decimal strings (null = not set).

/// tl_place_order_ex / tl_place_trailing_rate.
struct PlaceOrderCommand {
  clientId: int
  type: OrderType
  side: OrderSide
  qty: string
  price: string | null
  reduceOnly: bool
  attachStop: string | null
  attachTp: string | null
  trailDistance: string | null
  /// Policy v16: a trailing stop at this rate of the best close ("0.02" = 2%) instead of a distance.
  trailRate?: string | null
  /// Policy v18 (tl_place_order_tif): time in force, absent = gtc.
  tif?: TimeInForce
  /// Policy v18: N for tif "bars".
  tifBars?: int
}

union OptionOrderType = "market" | "limit"

/// tl_place_option_order.
struct PlaceOptionOrderCommand {
  clientId: int
  series: int
  side: OrderSide
  type: OptionOrderType
  qty: string
  premium: string | null
  /// Policy v18 (tl_place_option_order_tif): time in force, absent = gtc (ioc/fok need a limit).
  tif?: TimeInForce
  /// Policy v18: N for tif "bars".
  tifBars?: int
}

/// tl_link_oco (policy v18): two working orders, either filling first cancels the other.
struct LinkOcoCommand {
  clientId: int
  orderA: int
  orderB: int
}

/// tl_adjust_margin: add (> 0) or remove (< 0) isolated margin.
struct AdjustMarginCommand {
  clientId: int
  amount: string
}

/// tl_record_plan: the plan for the next exposure-increasing order.
struct RecordPlanCommand {
  clientId: int
  side: OrderSide
  skipped: bool
  option: bool
  loseScenario: bool
  invalidation: string | null
  target: string | null
  confidence: int
  plannedRisk: string | null
}

/// tl_answer_question: probability in basis points, or skipped.
struct AnswerQuestionCommand {
  clientId: int
  pBp: int
  skipped: bool
}

/// tl_answer_lesson: a lesson question of the mission's rubric (scoring v11); `choice` for multiple
/// choice, `value` (decimal string) for a numeric question.
struct AnswerLessonCommand {
  clientId: int
  question: int
  choice: int
  value: string | null
  skipped: bool
}

/// tl_cancel_order.
struct CancelOrderCommand {
  clientId: int
  orderId: int
}

/// tl_move_order: a working reduce-only stop or take-profit to a new price (policy v13).
struct MoveOrderCommand {
  clientId: int
  orderId: int
  price: string
}

/// tl_set_leverage.
struct SetLeverageCommand {
  clientId: int
  leverage: int
}

/// tl_close_position and tl_request_advice take only the idempotency key.
struct ClientIdCommand {
  clientId: int
}

struct CommandResult {
  accepted: bool
  reason: Reason
  orderId: int
  warning: Reason | null
}

/// Start options of a run: advice allowance and intel perks (engine policy v11); campaign capital
/// carried in and the curriculum's leverage cap (policy v12; absent = the mission's own rules).
struct RunOptionsView {
  adviceAllowance: int
  newsLead: int
  calendar: bool
  /// Decimal string > 0.
  startingBalance?: string
  /// > 0 lowers the mission's leverage cap.
  leverageCap?: int
}

# --- Debrief (tl_debrief) ---------------------------------------------------------------------

struct EngineFinding {
  code: FindingCode
  tone: FindingTone
  step: int
  count: int
  price: Decimal
  requested: Decimal
  amount: Decimal
  /// Scoring v14 findings only (revenge_trade, fomo_entry, averaging_down, risk_limit_exceeded).
  evidence?: FindingEvidence
}

/// Scoring v14: what a bias or risk-limit finding rests on (the action log and data visible at its step).
/// Each code writes only its own members.
struct FindingEvidence {
  /// revenge_trade: the losing trade's number, its exit bar and net loss.
  trade?: int
  exitStep?: int
  loss?: Decimal
  /// revenge_trade, fomo_entry: the entry's decision step.
  entryStep?: int
  /// revenge_trade: entry size over the losing trade's (planned risk, else quantity), basis points.
  sizeRatioBp?: int
  /// revenge_trade, averaging_down: the entry had a plan of its own.
  planned?: bool
  /// fomo_entry: (close - SMA20) / ATR14 in hundredths, signed by the side.
  extensionAtr?: int
  /// fomo_entry: consecutive closes in the entry's direction.
  closes?: int
  /// fomo_entry, averaging_down: the protective stop ("0" = none).
  stop?: Decimal
  /// averaging_down: the add's decision step, the average entry before and after, the unrealized loss
  /// at the add, the risk to the stop before and after, and the first entry's planned risk.
  addStep?: int
  avgBefore?: Decimal
  avgAfter?: Decimal
  unrealized?: Decimal
  riskBefore?: Decimal
  riskAfter?: Decimal
  planRisk?: Decimal
  /// risk_limit_exceeded: the limit, its value and the largest value seen at a close.
  limit?: RiskLimitKind
  limitBp?: int
  worstBp?: int
}

struct EngineTrade {
  n: int
  /// 0 = perpetual; otherwise the option series (prices are premiums).
  series: int
  /// Option rows only.
  kind?: OptionKind
  strike?: Decimal
  expiryStep?: int
  side: TradeSide
  entryStep: int
  exitStep: int | null
  qty: Decimal
  entryAvg: Decimal
  exitAvg: Decimal
  pnl: Decimal
  fees: Decimal
  /// Funding received (+) or paid (-) while the trade was open; included in `net`.
  funding: Decimal
  net: Decimal
  bars: int
  reason: ExitReason
  plannedRisk: Decimal
  rBp: int | null
  planRespected: bool | null
  /// Scoring v9: the revealed regime the trade was entered in (built-in missions; null for packs).
  regime?: RegimeLabel | null
  /// Perpetual rows only: the trade's stop (stop order, else the plan's invalidation; 0 = none).
  stop?: Decimal
  /// Perpetual rows only: highest leverage the position carried (at entry or re-leveraged while open).
  leverage?: int
  /// Perpetual rows only: the liquidation price that leverage implied (0 = none).
  liqPrice?: Decimal
  stopBeyondLiq?: bool
  /// Highest leverage that would have kept the stop in front of liquidation (0 = not even 1x); null when it was in front.
  safeLeverage?: int | null
  /// Perpetual rows only (report-only): moves of a reduce-only stop away from the entry while the trade was open.
  stopMovedAway?: int
}

union TradeSide = "long" | "short"

/// Approximate option P&L by Greek (engine); the residual is the spread paid (full revaluation, scoring v8).
struct GreekAttribution {
  delta: Decimal
  gamma: Decimal
  theta: Decimal
  vega: Decimal
  residual: Decimal
  total: Decimal
}

struct ScoreDimension {
  weight: int
  score: int | null
}

struct ScoreDimensions {
  risk: ScoreDimension
  plan: ScoreDimension
  understanding: ScoreDimension
  calibration: ScoreDimension
}

struct ScoreSummary {
  version: int
  total: int | null
  dims: ScoreDimensions
}

struct CalibrationSummary {
  resolved: int
  brierBp: int | null
}

/// Each piece of advice with its outcome 5 bars after the next open.
struct AdviceRowView {
  step: int
  stance: AdviceStance
  confidenceBp: int
  outcome: AdviceOutcome
}

/// One regime as it played: start bar, length, label and, for a drawn direction, +1 up / -1 down (0 = not drawn).
struct RegimeSpan {
  start: int
  bars: int
  label: RegimeLabel
  direction: int
}

struct SignalTally {
  hits: int
  samples: int
}

/// Hits and samples of four common reads inside one revealed span (entered at the next open, 5-bar horizon).
struct RegimeSignals : RegimeSpan {
  rsiFade: SignalTally
  bollingerFade: SignalTally
  macdFollow: SignalTally
  smaFollow: SignalTally
}

struct PackReveal {
  asset: string
  pair: string
  venue: string
  periodFrom: string
  periodTo: string
  source: string
  transformation: string
  gaps: int
  /// 'skip' / 'carryForward' when the gaps were filled with continuity bars, '' when the bars were joined.
  gapPolicy: PackGapPolicy
}

/// What the player did at one decision step (engine decision record, task 4.2).
struct DecisionView {
  step: int
  kind: DecisionKind
}

union LessonKind = "choice" | "numeric"

/// A lesson question without its key (texts are in the client catalogs by id).
struct LessonQuestionInfo {
  id: string
  kind: LessonKind
  /// Multiple choice: number of options; 0 for a numeric question.
  choices: int
  points: int
}

/// tl_lesson: a mission's lesson questions without the answer key (task 4.5).
struct LessonInfo {
  mission: string
  reviewed: bool
  questions: LessonQuestionInfo[]
}

/// Debrief: one lesson question with the player's answer and the key.
struct LessonResultView {
  id: string
  kind: LessonKind
  points: int
  maxPoints: int
  answered: bool
  skipped: bool
  correct: bool
  /// Choice index or decimal string; null when skipped or unanswered.
  given: int | Decimal | null
  answer: int | Decimal
}

/// Debrief: the lesson questions of the mission's rubric (scoring v11).
struct LessonResults {
  reviewed: bool
  points: int
  total: int
  questions: LessonResultView[]
}

struct DebriefData {
  mission: string
  alias: string
  status: RunStatus
  finalEquity: Decimal
  buyAndHoldPnl: Decimal
  flatPnl: Decimal
  syntheticMarket: bool
  seed: int
  startPrice: Decimal
  endPrice: Decimal
  score: ScoreSummary
  findings: EngineFinding[]
  lesson: LessonCode
  entries: int
  netPnl: Decimal
  calibration: CalibrationSummary
  trades: EngineTrade[]
  /// Spread + slippage paid against the reference price; already inside the fill prices.
  spreadSlippage: Decimal
  /// Option loss beyond the balance that the simulated fund covered (wallet floored at 0); usually 0.
  writtenOff: Decimal
  /// Null when no option was traded.
  greeks: GreekAttribution | null
  /// Engine-computed advisor points earned by this run (capped at 6).
  advisorPointsEarned: int
  advice: AdviceRowView[]
  adviceHitBp: int | null
  /// Pack runs only: what the masked market really was (never sent before the debrief).
  knownScenario?: bool
  /// Pack runs only: the pack's mode ('historical', ...).
  marketMode?: string
  /// Pack runs only: the pack's content digest.
  packDigest?: string
  reveal?: PackReveal
  /// Built-in missions (scoring v9): signals by revealed regime over this run's decision window.
  regimes?: RegimeSignals[]
  /// Scoring v11: the mission's rules as the run played them.
  missionRules: MissionRulesView
  /// Scoring v11: what the player did at each decision step the run advanced through.
  decisions: DecisionView[]
  /// Scoring v11: the lesson questions; null for a mission without a rubric.
  lessons: LessonResults | null
  /// Scoring v13 (report-only): the mission's reference structures on this seed; null for a mission
  /// without a comparison (every mission but m13-m22) and for pack runs.
  strategyComparison: StrategyComparison | null
  /// Scoring v14 (report-only): perpetual positions from flat to flat.
  episodes: PositionEpisode[]
}

union StopMoveKind = "to_breakeven" | "toward" | "away"

/// One perpetual fill of an episode.
struct EpisodeFill {
  step: int
  qty: Decimal
  price: Decimal
}

struct EpisodeStopMove {
  step: int
  kind: StopMoveKind
  price: Decimal
}

/// Scoring v14: a perpetual position from flat to flat (a flip ends one and starts the next).
struct PositionEpisode {
  /// The matching perpetual trade row's number.
  n: int
  side: TradeSide
  entryStep: int
  exitStep: int | null
  /// The first entry and every scale-in.
  entries: EpisodeFill[]
  /// Partial exits and the final one.
  exits: EpisodeFill[]
  stopMoves: EpisodeStopMove[]
  /// A trailing stop was working at some point.
  trailing: bool
  net: Decimal
  plannedRisk: Decimal
  rBp: int | null
  /// Best and worst excursion of the bars held against the first entry, in R (planned risk known).
  mfeRBp: int | null
  maeRBp: int | null
}

union ComparisonBasis = "player" | "reference"

/// One reference structure valued on this seed's path by the engine (its quotes, fees and margin).
struct StrategyComparisonRow {
  name: ComparisonStrategy
  /// Decision step whose next open filled the entry.
  entryStep: int
  /// Bar of the last fill or settlement that closed it; the run's last bar when still open.
  exitStep: int
  /// Equity at the end minus the run's initial capital, fees and funding included.
  netPnl: Decimal
  /// Largest peak-to-trough drop of equity (a positive amount).
  maxDrawdown: Decimal
  marginCalls: int
  /// The command reason of a leg refused at entry (nothing was placed, every amount is 0); null otherwise.
  refused: Reason | null
}

/// Debrief (scoring v13, report-only): computed after the run, never a score input or a digest input.
struct StrategyComparison {
  /// "player": entered at the decision step of the player's first option fill, at its quantity;
  /// "reference": the mission's reference step and quantity (no option traded).
  basis: ComparisonBasis
  entryStep: int
  /// Option contracts per leg; a perpetual leg trades qty x the option multiplier units.
  qty: Decimal
  rows: StrategyComparisonRow[]
}

# --- Seeded reveal (tl_mission_reveal) --------------------------------------------------------

/// One release as it played: the drawn outcome (G2) and what the market did with it.
struct RevealEvent {
  step: int
  kind: NewsKind
  actual: int
  surprise: int
  /// Drawn size: 100 = as designed.
  intensityPct: int
  /// Sampled transient reaction: 0 none, +1 up, -1 down.
  reaction: int
  expectation: int
  credibility: int
  /// Bars between announcement and release; 0 = unannounced.
  announceLead: int
  /// Open after the release against the release close, basis points.
  gapBp: int
  /// Close 3 bars after the release against the close before it, basis points.
  moveBp: int
  /// ATM straddle of the first live expiry the bar before, basis points of the price; -1 without options.
  impliedBp: int
}

/// G4 seeded reveal (tl_mission_reveal): the worker answers only once the run has ended.
struct MissionReveal {
  mission: string
  seed: int
  spans: RegimeSpan[]
  events: RevealEvent[]
}

# --- Private CSV import and packs -------------------------------------------------------------

struct CsvIssue {
  line: int
  code: string
}

struct CsvGap {
  line: int
  from: int
  to: int
  missing: int
}

/// Engine CSV report (tl_csv_validate). Codes are stable; see engine/src/csv_import.cpp.
struct CsvReport {
  ok: bool
  rows: int
  errors: CsvIssue[]
  errorCount: int
  gaps: CsvGap[]
  gapCount: int
  hasFunding: bool
  firstTime: int
  lastTime: int
}

/// tl_csv_validate when the metadata itself is unusable: the offending field instead of a report.
struct CsvMetaError {
  ok: bool
  metaError: string
}

union CsvValidation = CsvReport | CsvMetaError

union VolumeUnit = "base" | "quote"
union TimestampUnit = "s" | "ms"
union GapFill = "none" | GapPolicy

/// tl_pack_build_csv; the pack bytes come from tl_blob_data / tl_blob_size.
struct CsvPackBuild {
  ok: bool
  reason: string
  /// Unusable metadata or device seed only: the offending metadata field ('' for the seed).
  detail?: string
  report?: CsvReport
  scenarioId?: string
  digest?: string
  size?: int
}

/// What the player declares about a CSV (spec scenario-packs "Private CSV import").
struct CsvMeta {
  asset: string
  pair: string
  venue: string
  volumeUnit: VolumeUnit
  intervalSeconds: int
  timestampUnit: TimestampUnit
  leverageCap: int
  /// Policy v17: 'none' joins the bars across a gap; the others fill it with continuity bars.
  gapFill?: GapFill
}

union PackGapPolicy = GapPolicy | ""

/// Pack summary from tl_pack_validate: identity and rules, never prices or the reveal.
struct PackSummary {
  scenarioId: string
  mode: string
  private: bool
  knownScenario: bool
  digest: string
  signingKeyId: string
  timeframe: string
  totalBars: int
  warmupBars: int
  leverageCap: int
  allowShort: bool
  gaps: int
  /// 'skip' / 'carryForward' when the import filled its gaps with continuity bars, else ''.
  gapPolicy?: PackGapPolicy
  /// Manifest schema of the pack: 1, or 2 (mission texts and objectives, mark-price bars, settlement
  /// sub-bars, margin tiers).
  schemaVersion: int
  /// mission.json of a v2 pack: one entry per locale (pt-BR and en); empty without it.
  texts: PackText[]
}

/// A pack's own mission texts in one locale (v2 mission.json).
struct PackText {
  locale: string
  title: string
  briefing: string
}

struct PackCheck {
  ok: bool
  reason: string
  detail: string
  pack?: PackSummary
}

struct TrustedKey {
  id: string
  key: string
}

/// tl_run_file_verify (add-run-sharing-and-journal-stats D2). Refused: ok false with reason, path
/// (the first invalid member), pack (the digest a pack_required file needs) and detail (the file's
/// policy for policy_mismatch). Accepted: ok true and every optional field below.
struct RunFileVerdict {
  ok: bool
  reason?: RunFileReason
  path?: string
  pack: string
  detail?: string
  mission?: string
  seed?: int
  status?: RunStatus
  step?: int
  digest?: string
  eventsDigest?: string
  actions?: int
  rejected?: int
  /// SHA-256 of `run`: the id of an imported run.
  fileDigest?: string
  /// The canonical file (RFC 8785 text): what a client stores and exports again.
  run?: string
  /// tl_debrief of the replayed run; null while it is active.
  debrief?: DebriefData | null
}

union RunFileReason = "too_large" | "malformed" | "not_a_run_file" | "unsupported_version" | "invalid_field" | "policy_mismatch" | "unknown_mission" | "invalid_options" | "pack_required" | "pack_invalid" | "pack_mismatch" | "digest_mismatch"

/// tl_device_key: this device's signing key for its own imports; tl_signing_key: a publisher key.
struct DeviceKey {
  id: string
  publicKey: string
}

/// tl_pack_source_mission / tl_pack_source_csv (tools/packer, native only): the uncompressed source
/// archive is in tl_blob_data / tl_blob_size.
struct PackSourceResult {
  ok: bool
  reason: string
  /// The offending metadata field, or what failed (e.g. the unknown mission).
  detail: string
  /// tl_pack_source_csv only, once the metadata parsed.
  report?: CsvReport
  scenarioId?: string
  /// File names in the source archive, manifest.json excluded.
  files?: string[]
}

/// tl_pack_write / tl_pack_resign (tools/packer, native only): the signed pack is in tl_blob_data.
struct PackWriteResult {
  ok: bool
  reason: string
  digest: string
  size: int
  signingKeyId: string
}

# --- Option analysis (report only: add-academy-and-strategies design D4) ---------------------

union WhatIfLegKind = "call" | "put" | "perp"

/// One leg of a what-if request: run-less legs give strike, minutesToExpiry, iv and entry; run legs
/// name a listed series (or kind "perp") and may omit entry (the ask to buy, the bid to sell, the
/// last close for the perpetual).
struct WhatIfLegInput {
  kind?: WhatIfLegKind
  series?: int
  side: OrderSide
  qty: string
  strike?: string
  minutesToExpiry?: int
  /// Annualized implied volatility, e.g. "0.6".
  iv?: string
  entry?: string
  /// Perpetual legs only: a working protective stop. The expiry analytics (breakevens, maxProfit,
  /// maxLoss, the expiry curve) treat the leg as closed at the stop beyond it, without a gap; value,
  /// P&L, Greeks and the "today" curve ignore it. A stop on an option leg is invalid input.
  stop?: string
}

/// P&L grid over price and time (add-practice-and-advanced-strategies D4): lo..hi in `points` steps
/// (2..61) and up to 25 times: `bars` from the current step (run) or `minutes` elapsed (run-less).
struct WhatIfHeatmapInput {
  lo: string
  hi: string
  points: int
  bars?: int[]
  minutes?: int[]
}

/// Shifts: forward (absent = unchanged), time (run-less minutesElapsed, run bars) and IV in
/// volatility points ("-5" = -0.05), floored at 5% per leg.
struct WhatIfShiftInput {
  forward?: string
  minutesElapsed?: int
  bars?: int
  ivPoints?: string
}

/// Curve prices: lo..hi in `points` steps (2..401); absent = forward -30%..+30%, 61 points.
struct WhatIfGridInput {
  lo: string
  hi: string
  points: int
}

/// tl_option_whatif (run-less: forward, minutesPerStep, multiplier) and tl_run_option_whatif (legs,
/// shift and grid only).
struct WhatIfRequest {
  forward?: string
  minutesPerStep?: int
  multiplier?: string
  legs: WhatIfLegInput[]
  shift?: WhatIfShiftInput
  grid?: WhatIfGridInput
  /// Run-less: the price tick of the horizon breakeven search (default "0.01"); runs use the contract's.
  tick?: string
  /// D4: the P&L heatmap over price and time.
  heatmap?: WhatIfHeatmapInput
  /// D4 (run only): the run's own positions come first (the perpetual with its working reduce-only stop,
  /// every option position at its average entry), then the request's legs; the reply adds `risk`.
  holdings?: bool
}

/// Per unit as the option quote (value not tick-rounded; perpetual: the forward and delta 1); the
/// position's value and P&L are signed (short legs negative).
struct WhatIfLegView {
  kind: WhatIfLegKind
  side: OrderSide
  qty: Decimal
  /// Run legs: the series id and its expiry step; 0 otherwise.
  series: int
  expiryStep: int
  strike: Decimal | null
  entry: Decimal
  value: Decimal
  iv: Decimal | null
  /// The 5% floor applied after the IV shift.
  ivFloored: bool
  delta: Decimal
  gamma: Decimal
  theta: Decimal
  vega: Decimal
  positionValue: Decimal
  pnl: Decimal
}

/// Sums over the legs: delta and gamma in underlying units (1e-8), theta per step and vega per
/// volatility point as money.
struct WhatIfNetView {
  value: Decimal
  pnl: Decimal
  delta: Decimal
  gamma: Decimal
  theta: Decimal
  vega: Decimal
}

/// [price, P&L].
tuple CurvePointTuple = [Decimal, Decimal]

/// Exact analytics of the payoff at the (common) expiry; prices never go below 0.
struct WhatIfExpiryView {
  breakevens: Decimal[]
  maxProfit: Decimal | null
  /// A positive amount is a loss; null = unbounded (above the upper breakeven).
  maxLoss: Decimal | null
  curve: CurvePointTuple[]
}

/// Analytics at the first expiry when option legs have different expiries (D4): legs expiring then at
/// intrinsic value, later legs at their model value then (the run's IV base published now, the term
/// factor for their remaining time; run-less: the leg's IV plus ivPoints).
struct WhatIfHorizonView {
  /// The first expiry: a bar (run) or minutes from now (run-less).
  expiryStep: int
  /// On the price tick grid: the tick on the profitable side nearest each crossing (bisection between
  /// evaluated prices whose P&L signs differ).
  breakevens: Decimal[]
  /// Extremes over the grid, the strikes, the breakevens and the price 0; null = unbounded.
  maxProfit: Decimal | null
  /// A positive amount is a loss; null = unbounded above.
  maxLoss: Decimal | null
  /// True when the slope above every strike (later legs counted at intrinsic) is unfavorable.
  unboundedAbove: bool
  curve: CurvePointTuple[]
}

/// pnl[t][p]: the position's P&L against its entries at prices[p] after times[t] (D4).
struct WhatIfHeatmapView {
  prices: Decimal[]
  /// Bars from the current step (run) or minutes elapsed (run-less), as requested.
  times: int[]
  pnl: (Decimal[])[]
}

/// One declared risk limit and the measured value it compares (D9).
struct RiskLimitCheck {
  kind: RiskLimitKind
  limitBp: int
  /// |deltaBp|, gammaBp, |vegaBp| or -thetaBp.
  valueBp: int
  exceeded: bool
}

union RiskLimitKind = "delta" | "gamma" | "vega" | "theta"

/// Portfolio risk of the reply's legs (holdings: true), engine-computed (D4, D9).
struct WhatIfRiskView {
  /// Sum of units x delta (the perpetual's delta is 1).
  deltaUnits: Decimal
  deltaNotional: Decimal
  /// 1/2 x |sum of units x gamma| x (1% of the price)^2.
  gamma1pct: Decimal
  vegaPoint: Decimal
  thetaBar: Decimal
  /// The perpetual's next funding payment: -qty x price x the published next rate (positive = received).
  fundingNext: Decimal
  /// Each as signed basis points of equity (0 when equity <= 0).
  deltaBp: int
  gammaBp: int
  vegaBp: int
  thetaBp: int
  fundingBp: int
  equity: Decimal
  limits: RiskLimitCheck[]
}

/// tl_option_whatif / tl_run_option_whatif.
struct WhatIfResult {
  forward: Decimal
  /// The time shift reaches the options' common expiry: intrinsic values, no time-value Greeks.
  atExpiry: bool
  legs: WhatIfLegView[]
  net: WhatIfNetView
  /// Null unless every option leg shares one expiry.
  expiry: WhatIfExpiryView | null
  /// The P&L curve at the shifted time and IV.
  today: CurvePointTuple[]
  /// D4: present only when option legs have different expiries (absent otherwise, and from older builds).
  horizon?: WhatIfHorizonView
  /// D4: present when requested.
  heatmap?: WhatIfHeatmapView
  /// D4, D9: present with holdings: true.
  risk?: WhatIfRiskView
}

struct ComboLegInput {
  kind?: WhatIfLegKind
  series?: int
  side: OrderSide
  qty: string
  /// D2 of add-practice-and-advanced-strategies (option legs): "limit" with `premium`; absent = market.
  type?: OptionOrderType
  premium?: string
  /// D2: the combo's time in force on a limit leg (market legs ignore it).
  tif?: TimeInForce
  tifBars?: int
}

/// tl_combo_preview input: up to 8 legs (market, or option limit legs) in submission order.
struct ComboRequest {
  legs: ComboLegInput[]
}

/// One leg of the dry run, as the real command would answer at this step.
struct ComboLegView {
  accepted: bool
  reason: Reason
  /// The ask or bid it would cross now; the last close for the perpetual.
  quote: Decimal
  premium: Decimal
  fee: Decimal
  /// What the command checks: premium + fee to buy, the margin a sale adds, the perpetual's margin + fee.
  required: Decimal
  availableAfter: Decimal
}

/// tl_combo_preview: per leg, totals over the accepted legs (netPremium: credit > 0, debit < 0) and
/// an estimate once they fill at today's quotes (execution uses the next open).
struct ComboPreview {
  accepted: bool
  legs: ComboLegView[]
  netPremium: Decimal
  fees: Decimal
  required: Decimal
  availableAfter: Decimal
  optionMarginAfterFill: Decimal
  positionMarginAfterFill: Decimal
  availableAfterFill: Decimal
}

# --- Checkpoints and errors -------------------------------------------------------------------

/// tl_checkpoint: the run state as hex, restored by tl_run_restore / tl_run_restore_pack.
struct Checkpoint {
  checkpoint: string
  step: int
}

/// What a call returns instead of its result when it cannot answer (e.g. run_active, unknown_mission).
struct EngineError {
  error: string
}
